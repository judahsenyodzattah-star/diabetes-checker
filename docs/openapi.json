{
  "openapi": "3.1.0",
  "info": {
    "title": "Diabetes Prediction API",
    "description": "Educational diabetes-classification API. Responses from the mock adapter are demonstrations only. See docs/API.md.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/features": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Features",
        "operationId": "features_api_v1_features_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeaturesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/model": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Model Status",
        "operationId": "model_status_api_v1_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Metrics",
        "operationId": "metrics_api_v1_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predict": {
      "post": {
        "tags": [
          "prediction"
        ],
        "summary": "Predict",
        "operationId": "predict_api_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfusionMatrix": {
        "properties": {
          "tn": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tn"
          },
          "fp": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fp"
          },
          "fn": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fn"
          },
          "tp": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tp"
          }
        },
        "type": "object",
        "title": "ConfusionMatrix"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Fields",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FeaturesResponse": {
        "properties": {
          "provisional": {
            "type": "boolean",
            "title": "Provisional",
            "description": "True while any feature definition is unconfirmed"
          },
          "notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notice"
          },
          "features": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "provisional",
          "notice",
          "features"
        ],
        "title": "FeaturesResponse"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "model": {
            "$ref": "#/components/schemas/ModelStatus"
          }
        },
        "type": "object",
        "required": [
          "status",
          "api_version",
          "model"
        ],
        "title": "HealthResponse"
      },
      "MetricsFile": {
        "properties": {
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name"
          },
          "evaluated_on": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluated On",
            "description": "Free text, e.g. 'held-out test set, n=...'"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "confusion_matrix": {
            "$ref": "#/components/schemas/ConfusionMatrix"
          },
          "accuracy": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy"
          },
          "precision": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Precision"
          },
          "recall": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Recall"
          },
          "f1": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "F1"
          }
        },
        "type": "object",
        "title": "MetricsFile",
        "description": "Shape of backend/model_artifacts/metrics.json (all fields optional, null = not supplied)."
      },
      "MetricsResponse": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricsFile"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "available"
        ],
        "title": "MetricsResponse"
      },
      "ModelInfo": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "real"
            ],
            "title": "Mode"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "is_demonstration": {
            "type": "boolean",
            "title": "Is Demonstration",
            "description": "True when the response comes from the mock adapter and is NOT a real model output."
          }
        },
        "type": "object",
        "required": [
          "mode",
          "name",
          "is_demonstration"
        ],
        "title": "ModelInfo"
      },
      "ModelStatus": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "real"
            ],
            "title": "Mode"
          },
          "loaded": {
            "type": "boolean",
            "title": "Loaded"
          },
          "is_demonstration": {
            "type": "boolean",
            "title": "Is Demonstration"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Why the model could not load (real mode)"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "loaded",
          "is_demonstration"
        ],
        "title": "ModelStatus"
      },
      "Prediction": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "diabetes",
              "no_diabetes"
            ],
            "title": "Label",
            "description": "Predicted class"
          },
          "positive_class": {
            "type": "boolean",
            "title": "Positive Class",
            "description": "True when the predicted class is 'diabetes'"
          },
          "probability": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability",
            "description": "Model's estimated probability of the 'diabetes' class, or null if the model cannot provide one"
          }
        },
        "type": "object",
        "required": [
          "label",
          "positive_class"
        ],
        "title": "Prediction"
      },
      "PredictionRequest": {
        "properties": {
          "age": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Age",
            "description": "Age in whole years"
          },
          "sex": {
            "type": "string",
            "enum": [
              "female",
              "male"
            ],
            "title": "Sex"
          },
          "blood_pressure": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 30.0,
            "title": "Blood Pressure"
          },
          "cholesterol": {
            "type": "number",
            "maximum": 600.0,
            "minimum": 50.0,
            "title": "Cholesterol"
          },
          "bmi": {
            "type": "number",
            "maximum": 80.0,
            "minimum": 10.0,
            "title": "Bmi",
            "description": "kg/m\u00b2"
          },
          "smoker": {
            "type": "boolean",
            "title": "Smoker"
          },
          "physical_activity": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Physical Activity"
          },
          "family_history": {
            "type": "boolean",
            "title": "Family History"
          },
          "stress_level": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Stress Level"
          },
          "heart_disease": {
            "type": "boolean",
            "title": "Heart Disease"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "age",
          "sex",
          "blood_pressure",
          "cholesterol",
          "bmi",
          "smoker",
          "physical_activity",
          "family_history",
          "stress_level",
          "heart_disease"
        ],
        "title": "PredictionRequest",
        "description": "Model inputs. Unknown fields (including `diabetes`) are rejected.\n\nTypes are strict: numbers must be JSON numbers and yes/no fields must be\nJSON booleans, so strings such as \"yes\" or \"42\" are never silently coerced."
      },
      "PredictionResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "prediction",
          "model",
          "disclaimer"
        ],
        "title": "PredictionResponse"
      }
    }
  }
}
